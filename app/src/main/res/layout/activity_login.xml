<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="640dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="36dp">

        <ImageView
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:src="@drawable/app_logo"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="@string/login_title"
            android:textColor="#CFE4FF"
            android:textSize="15sp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#2600101F"
            app:tabIndicatorColor="@color/cyan"
            app:tabSelectedTextColor="@color/cyan"
            app:tabTextColor="#99CFE4FF"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_xtream" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_m3u" />
        </com.google.android.material.tabs.TabLayout>

        <LinearLayout
            android:id="@+id/llXtream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText android:id="@+id/etServer" style="@style/InputField"
                android:hint="@string/hint_server" android:inputType="textUri" />
            <EditText android:id="@+id/etUser" style="@style/InputField"
                android:hint="@string/hint_username" android:inputType="text" />
            <EditText android:id="@+id/etPass" style="@style/InputField"
                android:hint="@string/hint_password" android:inputType="textPassword" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llM3u"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText android:id="@+id/etM3u" style="@style/InputField"
                android:hint="@string/hint_m3u" android:inputType="textUri" />
        </LinearLayout>

        <EditText android:id="@+id/etName" style="@style/InputField"
            android:hint="@string/hint_name" android:inputType="text" />

        <CheckBox
            android:id="@+id/cbRemember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:buttonTint="@color/cyan"
            android:checked="true"
            android:text="@string/remember_me"
            android:textColor="#CFE4FF" />

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_blue"
            android:gravity="center"
            android:text="@string/btn_login"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/cyan"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- عبارة الدعم -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/support_full_text"
            android:textColor="#B8CFE4FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSupportNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="6dp"
            android:text="@string/support_number"
            android:textColor="@color/cyan"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
