<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/powerBtn"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_power_off"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/powerIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_power"
                app:tint="@color/text2" />
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="غير متصل"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/statusSub"
            style="@style/Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="اضغط الزر للاتصال" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="السيرفر"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/modeWarp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cloudflare WARP (مجاني)"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/modeCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="سيرفري الخاص (WireGuard)"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:id="@+id/customInfo"
                style="@style/Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportFile"
                    style="@style/BtnOutline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="ملف conf"
                    app:icon="@drawable/ic_folder"
                    app:iconTint="@color/accent2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPasteConf"
                    style="@style/BtnOutline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="لصق إعدادات"
                    app:icon="@drawable/ic_link"
                    app:iconTint="@color/accent2" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetWarp"
                style="@style/BtnOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="تجديد حساب WARP" />
        </LinearLayout>

        <TextView
            style="@style/Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="WARP مجاني وبدون حد للبيانات، ويتصل عبر أقرب سيرفر لـ Cloudflare. لاستخدام دولة معيّنة أضف سيرفرك الخاص." />
    </LinearLayout>
</ScrollView>
