<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة التحديث: شعار التطبيق فوق بطاقة التحديث -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000814" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/update_logo"
            android:layout_height="@dimen/update_logo"
            android:src="@drawable/app_logo"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="@dimen/update_card_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="-26dp"
            android:background="@drawable/bg_update_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_title"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="#D6E6FF"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/updProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="18dp"
                android:max="100"
                android:progressDrawable="@drawable/bg_update_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/update_now"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
