<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><gradient android:angle="270" android:startColor="#FF2A0C14" android:endColor="#FF120A10" /><corners android:radius="20dp" /><stroke android:width="3dp" android:color="@color/gold" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#FF2A0C14" /><corners android:radius="20dp" /><stroke android:width="2dp" android:color="@color/gold" /></shape></item>
    <item><shape><gradient android:angle="270" android:startColor="#E61B1D27" android:endColor="#E60F1016" /><corners android:radius="20dp" /><stroke android:width="1dp" android:color="#55F5C04A" /></shape></item>
</selector>
