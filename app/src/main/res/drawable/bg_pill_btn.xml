    <item android:state_pressed="true"><shape><solid android:color="#FF1A47B0" /><corners android:radius="30dp" /><stroke android:width="2dp" android:color="@color/gold" /></shape></item>
    <item><shape><gradient android:angle="270" android:startColor="#E6102660" android:endColor="#E6061433" /><corners android:radius="30dp" /><stroke android:width="2dp" android:color="@color/gold" /></shape></item>
</selector>
